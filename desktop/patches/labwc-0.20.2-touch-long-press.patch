+/* Opt-in for tablet sessions; leave upstream behavior unchanged otherwise. */
+static int
+hold_delay(void)
+{
+ const char *value = getenv("LABWC_TOUCH_LONG_PRESS_MS");
+ if (!value) return 0;
+ char *end;
+ long delay = strtol(value, &end, 10);
+ return *end || delay < 300 || delay > 2000 ? 0 : delay;
+}
+
+bool
+touch_long_press_enabled(void)
+{
+ return hold_delay() > 0;
+}
