+static void
+free_point(struct touch_point *point)
+{
+ cancel_hold(point);
+ if (point->emulated_down) {
+  struct timespec now;
+  clock_gettime(CLOCK_MONOTONIC, &now);
+  cursor_emulate_button(point->seat, BTN_LEFT, WL_POINTER_BUTTON_STATE_RELEASED,
+   now.tv_sec * 1000 + now.tv_nsec / 1000000);
