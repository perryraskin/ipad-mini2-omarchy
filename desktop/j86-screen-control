#!/usr/bin/python3
import socket,sys
command=sys.argv[1] if len(sys.argv)==2 else ''
if command not in ('screen-toggle','power-menu'):raise SystemExit('Usage: j86-screen-control screen-toggle|power-menu')
with socket.socket(socket.AF_UNIX,socket.SOCK_DGRAM) as client:client.sendto(command.encode(),'/run/j86-screen-control.sock')
