#!/usr/bin/python3
"""Serialize cold Firefox starts while retaining normal remote URL forwarding."""
import fcntl,os,pathlib,subprocess,sys,time,re

def native_wifi_ready():
    try:
        state=subprocess.run(['/usr/bin/nmcli','-g','GENERAL.STATE','device','show','wlan0'],capture_output=True,text=True,timeout=2)
        connectivity=subprocess.run(['/usr/bin/nmcli','-g','CONNECTIVITY','general'],capture_output=True,text=True,timeout=2)
        return state.returncode==connectivity.returncode==0 and state.stdout.split()[0]=='100' and connectivity.stdout.strip()=='full'
    except (OSError,subprocess.TimeoutExpired,IndexError):
        return False

def configure_network(profile,native):
    # This profile lives in RAM home. Keep the USB SOCKS settings as fallback.
    path=pathlib.Path(profile)/'user.js'
    text=path.read_text()
    line='user_pref("network.proxy.type", '+('0' if native else '1')+');'
    text,count=re.subn(r'^user_pref\("network\.proxy\.type",\s*\d+\);$',lambda _:line,text,flags=re.M)
    if count!=1:raise RuntimeError('Expected one browser proxy preference')
    path.write_text(text)

def launch(command,lock_path,settle=30,prepare=None):
    # A second click during slow USB-backed startup must wait before invoking
    # Firefox's own remote/profile-lock handling. Do not drop requested URLs.
    with pathlib.Path(lock_path).open('a') as lock:
        fcntl.flock(lock,fcntl.LOCK_EX)
        if prepare is not None:prepare()
        child=subprocess.Popen(command)
        try:child.wait(timeout=settle)
        except subprocess.TimeoutExpired:pass
        fcntl.flock(lock,fcntl.LOCK_UN)
    return child.wait()

if __name__=='__main__':
    os.environ.update(MOZ_ENABLE_WAYLAND='1',GDK_BACKEND='wayland',LIBGL_ALWAYS_SOFTWARE='1')
    runtime=pathlib.Path(os.environ['XDG_RUNTIME_DIR'])
    raise SystemExit(launch(['/usr/bin/firefox','--profile','/home/tablet/.mozilla/firefox/j86-usb',*sys.argv[1:]],runtime/'j86-browser-start.lock',prepare=lambda:configure_network('/home/tablet/.mozilla/firefox/j86-usb',native_wifi_ready())))
