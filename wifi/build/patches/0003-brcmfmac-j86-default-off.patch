+/* Exact J86 firmware binding is an explicit experiment, never auto-enabled. */
+static bool j86_allow_firmware;
+module_param(j86_allow_firmware, bool, 0444);
+MODULE_PARM_DESC(j86_allow_firmware, "Allow unqualified exact-J86 USB firmware (default off)");
 
